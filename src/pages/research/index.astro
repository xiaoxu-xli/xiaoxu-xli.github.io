---
import ContentCard from '../../components/ContentCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { researchThemes } from '../../data/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Research — Xiaoxu Li" description="Selected research by Xiaoxu Li.">
  <div class="page-section page-shell page-stack">
    <SectionHeading
      level="h1"
      eyebrow="Research"
      title="Research themes"
      description="Four verified themes connect research questions, technical methods, and evidence across the portfolio."
    />
    <section class="page-stack" aria-labelledby="research-records-title">
      <SectionHeading
        id="research-records-title"
        title="Structured research records"
        description="These summaries are sourced from FACTS.md; detailed case-study pages are deferred."
      />
      <div class="card-grid">
        {
          researchThemes.map((theme) => (
            <ContentCard
              eyebrow={`Theme ${String(theme.order).padStart(2, '0')}`}
              title={theme.title}
              description={theme.shortSummary}
            />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
