---
import ContentCard from '../../components/ContentCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { featuredPublications, publications } from '../../data/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Publications — Xiaoxu Li" description="Publications by Xiaoxu Li.">
  <div class="page-section page-shell page-stack">
    <SectionHeading
      level="h1"
      eyebrow="Publications"
      title="Publication record"
      description={`${publications.length} publication records are structured from FACTS.md, with ${featuredPublications.length} proposed for the featured selection.`}
    />
    <section class="page-stack" aria-labelledby="featured-publications-title">
      <SectionHeading
        id="featured-publications-title"
        title="Proposed featured publications"
        description="This relevance-based selection requires human approval; missing links and unstated statuses remain unset."
      />
      <div class="card-grid">
        {
          featuredPublications.map((publication) => (
            <ContentCard
              eyebrow={[publication.year, publication.status].filter(Boolean).join(' · ')}
              title={publication.title}
              description={`${publication.authors.join(', ')}. ${publication.venue}.`}
            />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
