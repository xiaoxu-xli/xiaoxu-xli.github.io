---
import ContentCard from '../../components/ContentCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { compactProjects, primaryProjects } from '../../data/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects — Xiaoxu Li" description="Selected engineering projects by Xiaoxu Li.">
  <div class="page-section page-shell page-stack">
    <SectionHeading
      level="h1"
      eyebrow="Projects"
      title="Applied systems"
      description="Structured project records connect research decisions with engineering systems and technical delivery."
    />
    <section class="page-stack" aria-labelledby="primary-projects-title">
      <SectionHeading
        id="primary-projects-title"
        title="Primary applied-AI projects"
        description="Detailed case-study layouts are deferred; these records expose only verified summaries."
      />
      <div class="card-grid">
        {
          primaryProjects.map((project) => (
            <ContentCard eyebrow="Primary project" title={project.title} description={project.shortSummary} />
          ))
        }
      </div>
    </section>
    <section class="page-stack" aria-labelledby="compact-projects-title">
      <SectionHeading
        id="compact-projects-title"
        title="Additional verified work"
        description="Compact records can be expanded in a later content milestone."
      />
      <div class="card-grid">
        {
          compactProjects.map((project) => (
            <ContentCard eyebrow="Compact record" title={project.title} description={project.shortSummary} />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
