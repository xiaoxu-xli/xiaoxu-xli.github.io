---
import PublicationCitation from '../components/PublicationCitation.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WorkCard from '../components/WorkCard.astro';
import {
  featuredPublications,
  homepageWork,
  professionalExperience,
  profile,
} from '../data/content';
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = professionalExperience[0];
const experienceHighlights = experience
  ? [experience.highlights[0], experience.highlights[3], experience.highlights[6]].filter(
      (highlight): highlight is string => Boolean(highlight),
    )
  : [];

const formatMonthYear = (value: string) => {
  const [year, month] = value.split('-').map(Number);

  return new Intl.DateTimeFormat('en-AU', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(Date.UTC(year, month - 1, 1)));
};
---

<BaseLayout
  title={`${profile.name} — ${profile.homepagePositioning}`}
  description={profile.homepageIntroduction.join(' ')}
>
  <section class="home-hero page-shell" aria-labelledby="page-title">
    <p class="home-hero__eyebrow">Research and engineering portfolio</p>
    <h1 id="page-title">{profile.name}</h1>
    <p class="home-hero__role">{profile.homepagePositioning}</p>
    <p class="home-hero__domains">{profile.domains.join(' · ')}</p>
    <p class="home-hero__introduction">{profile.homepageIntroduction.join(' ')}</p>
    <ul class="profile-links" aria-label="Profile links">
      <li><a href={profile.links.email}>Email</a></li>
      <li><a href={profile.links.googleScholar} rel="me">Google Scholar</a></li>
      {profile.links.github && <li><a href={profile.links.github}>GitHub</a></li>}
      {profile.links.cv && <li><a href={profile.links.cv}>CV</a></li>}
    </ul>
  </section>

  <section id="about" class="page-section home-section" aria-labelledby="about-title">
    <div class="page-shell about-layout">
      <SectionHeading
        id="about-title"
        eyebrow="About"
        title="Research depth, applied delivery"
      />
      <div class="about-copy">
        {profile.about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section id="work" class="page-section home-section home-section--muted" aria-labelledby="work-title">
    <div class="page-shell home-section-stack">
      <SectionHeading
        id="work-title"
        eyebrow="Selected work"
        title="Across research and production"
        description="Medical imaging research, applied machine learning, production systems, and modern AI applications presented as one connected body of work."
      />
      <div class="work-grid">
        {homepageWork.map((item) => <WorkCard item={item} />)}
      </div>
    </div>
  </section>

  <section id="publications" class="page-section home-section" aria-labelledby="publications-title">
    <div class="page-shell home-section-stack">
      <div class="section-introduction">
        <SectionHeading
          id="publications-title"
          eyebrow="Selected publications"
          title="Research contributions"
          description={`${featuredPublications.length} publications selected across medical image analysis, segmentation, reconstruction, and point-cloud learning.`}
        />
        <a class="section-link" href={profile.links.googleScholar} rel="me">
          View full publication list on Google Scholar <span aria-hidden="true">→</span>
        </a>
      </div>
      <ol class="publication-list">
        {
          featuredPublications.map((publication) => (
            <PublicationCitation publication={publication} />
          ))
        }
      </ol>
    </div>
  </section>

  {
    experience && (
      <section id="experience" class="page-section home-section home-section--muted" aria-labelledby="experience-title">
        <div class="page-shell home-section-stack">
          <SectionHeading
            id="experience-title"
            eyebrow="Experience"
            title={experience.organization}
            description={`${experience.location} · ${formatMonthYear(experience.startDate)} – Present`}
          />
          <div class="experience-layout">
            <ol class="role-timeline" aria-label="Role progression">
              {experience.roles.map((role) => (
                <li>
                  <p class="role-timeline__title">{role.title}</p>
                  <p class="role-timeline__dates">
                    {formatMonthYear(role.startDate)} – {role.endDate ? formatMonthYear(role.endDate) : 'Present'}
                  </p>
                </li>
              ))}
            </ol>
            <ul class="experience-highlights">
              {experienceHighlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <section class="page-section home-section" aria-labelledby="education-title">
    <div class="page-shell home-section-stack">
      <SectionHeading id="education-title" eyebrow="Education" title="Academic background" />
      <ol class="education-list">
        {
          profile.education.map((education) => (
            <li>
              <h3>{education.qualification}</h3>
              <p>{education.institution}</p>
              <p class="education-list__meta">
                {education.startYear}–{education.endYear} · {education.location}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="contact" class="contact-section page-section--compact" aria-labelledby="contact-title">
    <div class="page-shell contact-layout">
      <SectionHeading
        id="contact-title"
        eyebrow="Contact"
        title={profile.location}
        description={profile.formalRole}
      />
      <ul class="profile-links" aria-label="Contact and profile links">
        <li><a href={profile.links.email}>Email</a></li>
        <li><a href={profile.links.googleScholar} rel="me">Google Scholar</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  :global(#about),
  :global(#work),
  :global(#publications),
  :global(#experience),
  :global(#contact) {
    scroll-margin-top: var(--space-6);
  }

  .home-hero {
    display: grid;
    gap: var(--space-4);
    padding-block: clamp(var(--space-12), 7vw, var(--space-20));
  }

  .home-hero__eyebrow {
    margin: 0;
    color: var(--color-accent-strong);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-caps);
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: var(--width-narrow);
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    line-height: var(--line-height-tight);
  }

  .home-hero__role,
  .home-hero__domains,
  .home-hero__introduction {
    margin: 0;
  }

  .home-hero__role {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-heading);
  }

  .home-hero__domains {
    max-width: var(--width-reading);
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .home-hero__introduction {
    max-width: var(--width-reading);
    padding-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--font-size-md);
    line-height: 1.7;
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    padding: var(--space-2) 0 0;
    margin: 0;
    list-style: none;
  }

  .profile-links a,
  .section-link {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }

  .home-section {
    border-top: 1px solid var(--color-border);
  }

  .home-section--muted {
    background: var(--color-surface-muted);
  }

  .home-section-stack {
    display: grid;
    gap: clamp(var(--space-8), 5vw, var(--space-12));
  }

  .about-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(var(--space-8), 8vw, var(--space-20));
  }

  .about-copy {
    max-width: var(--width-reading);
  }

  .about-copy p {
    color: var(--color-text-muted);
    font-size: var(--font-size-md);
    line-height: 1.75;
  }

  .about-copy p:last-child {
    margin-bottom: 0;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .section-introduction {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .section-link {
    flex: 0 0 auto;
  }

  .publication-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(var(--space-8), 6vw, var(--space-16));
    padding-left: var(--space-6);
    margin: 0;
  }

  .experience-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(var(--space-8), 8vw, var(--space-16));
  }

  .role-timeline,
  .experience-highlights,
  .education-list {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .role-timeline li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-6);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--color-border-strong);
  }

  .role-timeline__title,
  .role-timeline__dates {
    margin: 0;
  }

  .role-timeline__title {
    font-weight: var(--font-weight-medium);
  }

  .role-timeline__dates {
    color: var(--color-text-subtle);
    font-size: var(--font-size-sm);
    white-space: nowrap;
  }

  .experience-highlights {
    display: grid;
    align-content: start;
    gap: var(--space-5);
  }

  .experience-highlights li {
    position: relative;
    padding: 0 0 var(--space-5) var(--space-6);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    line-height: 1.65;
  }

  .experience-highlights li::before {
    position: absolute;
    top: 0.7em;
    left: 0;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-accent);
    content: '';
  }

  .education-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .education-list li {
    min-width: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-strong);
  }

  .education-list h3 {
    font-size: var(--font-size-base);
    line-height: 1.5;
  }

  .education-list p {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.55;
  }

  .education-list__meta {
    color: var(--color-text-subtle) !important;
  }

  .contact-section {
    border-top: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .contact-layout {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-8);
  }

  @media (max-width: 54rem) {
    .about-layout,
    .work-grid,
    .publication-list,
    .experience-layout {
      grid-template-columns: 1fr;
    }

    .education-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 42rem) {
    .section-introduction,
    .contact-layout {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-5);
    }

    .role-timeline li {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .role-timeline__dates {
      white-space: normal;
    }

    .education-list {
      grid-template-columns: 1fr;
    }
  }
</style>
