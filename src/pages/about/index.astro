---
import ContentCard from '../../components/ContentCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { siteConfig } from '../../config/site';
import { professionalExperience, profile } from '../../data/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Xiaoxu Li" description="About Xiaoxu Li, Senior Research Engineer.">
  <div class="page-section page-shell page-stack">
    <SectionHeading
      level="h1"
      eyebrow="About"
      title={siteConfig.name}
      description={profile.summary}
    />
    <section class="page-stack" aria-labelledby="experience-records-title">
      <SectionHeading
        id="experience-records-title"
        title="Professional experience"
        description="Role dates and organization details are represented as stable structured records."
      />
      <div class="card-grid">
        {
          professionalExperience.map((experience) => (
            <ContentCard
              eyebrow={`Since ${experience.startDate}`}
              title={experience.organization}
              description={`${experience.location}. ${experience.roles.map((role) => role.title).join(' · ')}.`}
            />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
