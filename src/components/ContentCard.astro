---
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  href?: string;
  linkLabel?: string;
  headingLevel?: 'h2' | 'h3';
}

const {
  title,
  description,
  eyebrow,
  href,
  linkLabel = 'View section',
  headingLevel = 'h3',
} = Astro.props;
const Heading = headingLevel;
---

<article class:list={['content-card', { 'content-card--linked': href }]}>
  {eyebrow && <p class="content-card__eyebrow">{eyebrow}</p>}
  <Heading class="content-card__title">
    {href ? <a href={href}>{title}</a> : title}
  </Heading>
  <p class="content-card__description">{description}</p>
  {href && (
    <p class="content-card__action" aria-hidden="true">
      {linkLabel}<span>→</span>
    </p>
  )}
</article>

<style>
  .content-card {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 13rem;
    flex-direction: column;
    padding: clamp(var(--space-5), 4vw, var(--space-8));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .content-card--linked:hover {
    border-color: var(--color-border-strong);
  }

  .content-card__eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-text-subtle);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-caps);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .content-card__title {
    font-size: var(--font-size-md);
  }

  .content-card__title a {
    color: var(--color-text);
    text-decoration-color: transparent;
  }

  .content-card__title a::after {
    position: absolute;
    inset: 0;
    content: '';
  }

  .content-card__title a:hover {
    color: var(--color-accent-strong);
    text-decoration-color: var(--color-accent);
  }

  .content-card__description {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.7;
  }

  .content-card__action {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: auto 0 0;
    padding-top: var(--space-8);
    color: var(--color-accent-strong);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
  }
</style>
