---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  id?: string;
  level?: 'h1' | 'h2';
}

const { title, description, eyebrow, id, level = 'h2' } = Astro.props;
const Heading = level;
---

<header class:list={['section-heading', { 'section-heading--page': level === 'h1' }]}>
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  <Heading id={id}>{title}</Heading>
  {description && <p class="section-heading__description">{description}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    max-width: var(--width-reading);
    gap: var(--space-3);
  }

  .section-heading--page {
    gap: var(--space-4);
  }

  .section-heading__eyebrow {
    margin: 0;
    color: var(--color-accent-strong);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-caps);
    line-height: 1.4;
    text-transform: uppercase;
  }

  .section-heading__description {
    max-width: var(--width-reading);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-md);
    line-height: 1.7;
  }
</style>
