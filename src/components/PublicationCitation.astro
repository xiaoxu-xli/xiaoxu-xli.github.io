---
import type { Publication } from '../types/content';

interface Props {
  publication: Publication;
}

const { publication } = Astro.props;

const conferenceAbbreviations: Readonly<Record<string, string>> = {
  '33rd International Conference on Neural Information Processing (ICONIP 2026)': 'ICONIP',
  'IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)': 'ICASSP',
  'Medical Image Computing and Computer-Assisted Intervention (MICCAI)': 'MICCAI',
};

const conference = conferenceAbbreviations[publication.venue];
const venueLabel = conference
  ? `${conference} ${publication.year}`
  : `${publication.venue} · ${publication.year}`;
---

<li class="publication-citation">
  <article>
    <h3>{publication.title}</h3>
    <p class="publication-citation__authors">
      {
        publication.authors.map((author, index) => (
          <>
            {author === 'Xiaoxu Li' ? <strong>{author}</strong> : author}
            {index < publication.authors.length - 1 ? ', ' : ''}
          </>
        ))
      }
    </p>
    <p class="publication-citation__venue">{venueLabel}</p>
  </article>
</li>

<style>
  .publication-citation {
    min-width: 0;
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border);
  }

  .publication-citation::marker {
    color: var(--color-text-subtle);
    font-size: var(--font-size-xs);
    font-variant-numeric: tabular-nums;
  }

  article {
    display: grid;
    gap: var(--space-2);
  }

  h3 {
    max-width: var(--width-reading);
    font-size: var(--font-size-base);
    line-height: 1.45;
  }

  .publication-citation__authors,
  .publication-citation__venue {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: 1.55;
  }

  .publication-citation__authors strong {
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
  }

  .publication-citation__venue {
    color: var(--color-text-subtle);
    font-style: italic;
  }
</style>
